    "crf": 24,
    "bitrate": 64000000,
    "intra_period": 60,
    "record_on_tracking": true,
    "minimum_free_gib": 20.0
  },
  "transport": {
    "backend": "uart",
    "uart_device": "/dev/ttyAMA0",
    "uart_baud": 460800,
    "unix_socket": "/tmp/macaque-eye-tracker.sock",
    "transaction_size": 64
  },
  "preview": {
    "enabled": false,
    "max_display_width": 1920,
    "max_display_height": 1080,
    "show_threshold_mask": true,
    "window_name": "Macaque eye tracker"
  },
  "roi_config": "rois.json"
