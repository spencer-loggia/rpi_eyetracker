{
  "camera": {
    "camera_index": 0,
    "sensor_width": 5120,
    "sensor_height": 720,
    "sensor_bit_depth": 8,
    "video_width": 3840,
    "video_height": 540,
    "analysis_width": 2560,
    "analysis_height": 360,
    "fps": 30.0,
    "buffer_count": 6,
    "exposure_us": 19000,
    "analogue_gain": 4.0,
    "brightness": 0.0,
    "contrast": 1.0,
    "sharpness": 0.0,
    "ir_led_pin": null,
    "ir_led_warmup_seconds": 0.2
  },
  "tracker": {
    "min_pupil_diameter_px": 8.0,
    "max_pupil_diameter_fraction": 0.75,
    "min_axis_ratio": 0.45,
    "min_contrast": 8.0,
    "pupil_size_bias": 0.0,
    "min_confidence": 0.48,
    "threshold_percentiles": [2.0, 5.0, 9.0, 14.0],
